@model IEnumerable<SGC_PORTFOLIO.Models.BlogEntry>

@{
    ViewData["Title"] = "Blogs";
}

<div class="blog-content">
    <h1 class="blog-title">Blog Entries</h1>

    @if (Model != null && Model.Any())
    {
        <div class="blog-list">
            @foreach (var blogEntry in Model)
            {
                <div class="blog-card">
                    <h2>
                        <a href="@Url.Action("Details", "Blog", new { title = blogEntry.Title })">@blogEntry.Title</a>
                    </h2>
                    <p class="blog-summary">@blogEntry.Summary</p>
                    <p class="blog-date"><small>@blogEntry.CreatedAt.ToString("MMMM dd, yyyy")</small></p>
                </div>
            }
        </div>
    }
    else
    {
        <p>No blog entries available.</p>
    }
</div>
